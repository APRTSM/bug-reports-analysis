{
  "bug": {
    "bug_id": "Lang-45",
    "project": "Lang",
    "summary": "WordUtils.abbreviate bug when lower is greater than str.length",
    "description": "In WordUtils.abbreviate, upper is adjusted to the length of the string, then to lower.\n\nBut lower is never adjusted to the length of the string, so if lower is greater than str.lengt(), upper will be too...\n\nThen, str.substring(0, upper) throw a StringIndexOutOfBoundsException\n\nThe fix is to adjust lower to the length of the string"
  },
